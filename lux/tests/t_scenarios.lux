# ── Retención de versiones y papelera ───────────────────────────────────────

fn int usage(Json c):
    return (await get(c, "/api/usage"))["body"]["used"]

fn bool t_retention(Json res):
    Json c = client("203.0.113.9")
    await register(c, "ana", "Contrasena1")
    await login(c, "ana", "Contrasena1")

    # max_per_file = 2: el historial no pasa de dos versiones.
    Json f = (await api_upload(c, "doc.txt", "uno", ""))["body"]
    string trace = "3"
    for string v in ["dos", "tres", "cuatro", "cinco"]:
        Json ow = await upload_file(c, "/api/files", "file", "doc.txt", v, { "overwrite": "true" })
        trace = trace + "," + str(await usage(c)) + "(" + str(ow["body"]["size"]) + ")"
    Json detail = await get(c, "/files/" + f["id"] + "/detail")
    check(res, "versiones: el historial se recorta a max_per_file", len(ids_after(detail["text"], "/versions/")) == 2, str(len(ids_after(detail["text"], "/versions/"))))
    # 5 versiones en total, pero sólo se cuentan la actual y las dos conservadas.
    # Quedan "cinco" (actual) y las dos últimas archivadas, "cuatro" y "tres".
    check(res, "versiones: la cuota cuenta la actual y las conservadas", await usage(c) == 5 + 6 + 4, trace)

    # Retención de la papelera: pasado el plazo, el mantenimiento la vacía.
    Json g = (await api_upload(c, "viejo.txt", "contenido viejo " + hash.uuid(), ""))["body"]
    await call(c, "DELETE", "/api/files/" + g["id"], null, {})
    check(res, "papelera: el borrado va a la papelera", len((await get(c, "/api/trash"))["body"]["items"]) == 1, "")
    await sleep(2500)
    Json run = await cli(["maintenance"])
    check(res, "papelera: el mantenimiento purga lo caducado", run["stdout"].contains("trash=1"), str(run))
    check(res, "papelera: ya no está", len((await get(c, "/api/trash"))["body"]["items"]) == 0, "")
    check(res, "papelera: el blob se libera", not run["stdout"].contains("blobs=0"), str(run))
    return true

fn bool t_notrash(Json res):
    Json c = client("203.0.113.9")
    await register(c, "ana", "Contrasena1")
    await login(c, "ana", "Contrasena1")
    Json f = (await api_upload(c, "doc.txt", "x".repeat(100), ""))["body"]
    await upload_file(c, "/api/files", "file", "doc.txt", "y".repeat(40), { "overwrite": "true" })
    check(res, "sin versiones: sobrescribir sustituye y libera lo anterior", await usage(c) == 40, str(await usage(c)))
    Json d = await get(c, "/files/" + f["id"] + "/detail")
    check(res, "sin versiones: no hay historial", not d["text"].contains("Versiones anteriores"), "")
    await call(c, "DELETE", "/api/files/" + f["id"], null, {})
    check(res, "sin papelera: el borrado es definitivo", len((await get(c, "/api/trash"))["body"]["items"]) == 0 and await usage(c) == 0, str(await usage(c)))
    return true

fn bool t_trashfree(Json res):
    Json c = client("203.0.113.9")
    await register(c, "ana", "Contrasena1")
    await login(c, "ana", "Contrasena1")
    Json f = (await api_upload(c, "doc.txt", "x".repeat(100), ""))["body"]
    await call(c, "DELETE", "/api/files/" + f["id"], null, {})
    check(res, "papelera sin cuota: lo borrado deja de contar", await usage(c) == 0, str(await usage(c)))
    await post(c, "/api/files/" + f["id"] + "/restore", null)
    check(res, "papelera sin cuota: al restaurar vuelve a contar", await usage(c) == 100, str(await usage(c)))
    return true

get endpoint("/run/retention"):
    Json res = new_results("retention")
    await t_retention(res)
    return text(summary(res)).status(res["fail"] == 0 ? 200 : 500)

get endpoint("/run/notrash"):
    Json res = new_results("notrash")
    await t_notrash(res)
    return text(summary(res)).status(res["fail"] == 0 ? 200 : 500)

get endpoint("/run/trashfree"):
    Json res = new_results("trashfree")
    await t_trashfree(res)
    return text(summary(res)).status(res["fail"] == 0 ? 200 : 500)
