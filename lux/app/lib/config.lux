# Claves que sólo pueden tocarse en el fichero o por entorno, nunca desde el
# panel: cambiarlas en caliente rompería el proceso o permitiría a un admin
# comprometido reescribir el secreto de firma.
fn List<string> locked_keys():
    return ["storage.root", "storage.hash_algorithm", "security.secret_key", "security.password_hash"]

# ── Normalización ───────────────────────────────────────────────────────────

fn bool is_size_key(string key):
    return key == "storage.max_upload_size" or key == "storage.default_quota" or key == "thumbnails.max_source_size" or key.ends_with(".quota") or (key.starts_with("roles.") and key.ends_with(".max_upload_size"))

fn bool is_duration_key(string key):
    return in_list(key, ["trash.retention", "versions.retention", "security.session.lifetime", "security.session.absolute_lifetime", "security.lockout.window", "security.lockout.duration", "sharing.default_link_expiry", "sharing.max_link_expiry", "audit.retention", "maintenance.interval"]) or (key.starts_with("rate_limit.") and key.ends_with(".window"))

# Convierte un valor leído del fichero, de la base de datos o del entorno al
# formato interno de su clave. Los tamaños y duraciones admiten sufijos
# ("2GB", "30d"); 0 en un límite de tamaño significa "sin límite".
fn Json normalize(string key, Json value):
    if value == null:
        return null
    if is_size_key(key):
        Json r = parse_size(str(value))
        if not r["ok"]:
            return null
        return r["v"] == 0 ? null : r["v"]
    if is_duration_key(key):
        Json r = parse_duration(str(value))
        if not r["ok"]:
            return null
        return r["v"]
    if key.ends_with("_networks") or key.ends_with("_extensions") or key.ends_with("_domains") or key.ends_with("_types"):
        return normalize_list(key, value)
    return value

fn Json normalize_list(string key, Json value):
    List<Json> out = []
    for Json item in value:
        string s = str(item).trim()
        if s == "":
            continue
        if key.ends_with("_extensions"):
            s = s.lower()
            s = s.starts_with(".") ? s : "." + s
        out.add(s)
    return out

# ¿Es un diccionario? Json no tiene un typeof: se prueba con una operación que
# sólo existe en los diccionarios.
fn bool is_dict(Json v):
    try:
        v.keys()
        return true
    catch e:
        return false

# {"a": {"b": 1}} -> {"a.b": 1}. Las listas y los escalares quedan tal cual.
fn Json flatten(Json node, string prefix, Json out):
    for string k in node:
        string key = prefix == "" ? k : prefix + "." + k
        if is_dict(node[k]):
            flatten(node[k], key, out)
        else:
            out[key] = node[k]
    return out

fn Json parse_loose(string raw):
    try:
        return json.parse(raw)
    catch e:
        return raw

# ── Carga ───────────────────────────────────────────────────────────────────

fn string config_path():
    return os.getenv("DRIVE_CONFIG", "config/config.json")

fn Json file_config():
    string path = config_path()
    if not os.is_file(path):
        return {}
    try:
        string raw = await os.read_file(path)
        return flatten(json.parse(raw), "", {})
    catch e:
        log.error("no se pudo leer " + path + ": " + e.message)
        return {}

fn Json db_overrides():
    Json out = {}
    try:
        List<Json> rows = await sqlite.query("select key, value from settings")
        for Json r in rows:
            if in_list(r["key"], locked_keys()):
                continue
            Json parsed = json.parse(r["value"])
            out[r["key"]] = parsed["v"]
    catch e:
        # La tabla puede no existir aún en la primera petición.
        return {}
    return out

# Reconstruye la configuración efectiva.
fn Json build_config():
    Json c = defaults()
    Json known = defaults()
    Json fromfile = await file_config()
    for string k in fromfile:
        if known.has(k):
            c[k] = normalize(k, fromfile[k])
    Json fromdb = await db_overrides()
    for string k in fromdb:
        if known.has(k):
            c[k] = normalize(k, fromdb[k])
    for string k in known:
        string envname = "DRIVE_" + k.upper().replace(".", "__")
        string raw = os.getenv(envname, "")
        if raw != "":
            c[k] = normalize(k, parse_loose(raw))
    c["app.base_url"] = str(c["app.base_url"]).trim()
    while str(c["app.base_url"]).ends_with("/"):
        c["app.base_url"] = str(c["app.base_url"]).slice(0, len(str(c["app.base_url"])) - 1)
    return c

# Configuración activa. Se recarga con invalidate_config().
fn Json config():
    Json c = state.get("cfg", null)
    if c == null:
        c = await build_config()
        state.set("cfg", c)
    return c

# Versión sin base de datos, para los manejadores de error: la guardada o, si
# todavía no hay ninguna, los defaults.
fn Json config_now():
    Json c = state.get("cfg", null)
    return c == null ? defaults() : c

fn bool invalidate_config():
    state.remove("cfg")
    return true

# Perfil de un rol, con caída al más restrictivo.
fn Json role_profile(Json cf, string role):
    string name = cf.has("roles." + role + ".can_upload") ? role : "guest"
    string p = "roles." + name + "."
    return {
        "name": name,
        "quota": cf[p + "quota"],
        "max_upload_size": cf[p + "max_upload_size"],
        "can_share_public": cf[p + "can_share_public"],
        "can_share_internal": cf[p + "can_share_internal"],
        "can_upload": cf[p + "can_upload"],
        "can_delete": cf[p + "can_delete"],
        "can_manage_users": cf[p + "can_manage_users"],
        "can_edit_settings": cf[p + "can_edit_settings"]
    }

# Avisos de configuración peligrosa.
fn List<string> config_warnings(Json cf):
    List<string> w = []
    if cf["security.secret_key"] == "CAMBIAME-EN-PRODUCCION":
        w.add("security.secret_key sigue siendo el valor por defecto: cualquiera puede falsificar sesiones. Cámbialo ya.")
    if str(cf["app.base_url"]).starts_with("https://") and not cf["security.session.cookie_secure"]:
        w.add("base_url es https pero security.session.cookie_secure es false: la cookie de sesión viajará también por http.")
    if cf["network.trusted_mode"] == "full" and not cf["network.trusted_user"]:
        w.add("network.trusted_mode es 'full' pero network.trusted_user está vacío: el acceso por red de confianza quedará desactivado.")
    if cf["network.trusted_mode"] != "none" and len(cf["network.trusted_networks"]) == 0:
        w.add("network.trusted_mode está activo pero no hay trusted_networks definidas: ningún cliente será considerado de confianza.")
    if cf["server.behind_proxy"] and len(cf["server.trusted_proxies"]) == 0:
        w.add("server.behind_proxy es true sin trusted_proxies: se aceptarán cabeceras X-Forwarded-For de cualquier origen, lo que permite falsificar la IP del cliente y saltarse las redes de confianza.")
    return w

# ── Catálogo de ajustes editables en caliente ───────────────────────────────

fn Json setting(string key, string label, string kind, string help, List<string> options):
    return { "key": key, "label": label, "kind": kind, "help": help, "options": options }

