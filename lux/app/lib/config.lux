# El ajuste con esa clave, o null.
fn Json find_setting(string key):
    for Json g in settings_groups():
        for Json s in g["settings"]:
            if s["key"] == key:
                return s
    return null

# Texto de un formulario -> valor interno. {"ok": bool, "v": valor, "err": msg}
fn Json parse_setting(Json s, string raw):
    string r = raw.trim()
    string kind = s["kind"]
    switch kind:
        case "bool":
            return { "ok": true, "v": truthy(r), "err": "" }
        case "int":
            try:
                return { "ok": true, "v": r == "" ? 0 : int(r), "err": "" }
            catch e:
                return { "ok": false, "v": null, "err": "no es un número: " + r }
        case "list":
            List<string> items = []
            for string part in r.split(","):
                if part.trim() != "":
                    items.add(part.trim())
            return { "ok": true, "v": items, "err": "" }
        case "size":
            if r == "":
                return { "ok": true, "v": null, "err": "" }
            return parse_size(r)
        case "duration":
            if r == "":
                return { "ok": true, "v": null, "err": "" }
            return parse_duration(r)
        case "choice":
            if len(s["options"]) > 0 and not in_list(r, s["options"]):
                return { "ok": false, "v": null, "err": "valor no admitido: " + r }
            return { "ok": true, "v": r, "err": "" }
        else:
            return { "ok": true, "v": r == "" ? null : r, "err": "" }

# Valor interno -> texto para el formulario.
fn string display_setting(Json s, Json value):
    if value == null:
        return ""
    string kind = s["kind"]
    if kind == "list":
        List<string> parts = []
        for Json v in value:
            parts.add(str(v))
        return parts.join(", ")
    if kind == "size":
        return value == 0 ? "" : format_size(value)
    if kind == "duration":
        return humanize_duration(value)
    if kind == "bool":
        return value ? "true" : "false"
    return str(value)

# ── Escritura de ajustes ────────────────────────────────────────────────────

# Guarda un ajuste y recarga la configuración.
fn bool set_override(string key, Json value, Json user_id):
    string stored = json.stringify({ "v": value })
    await sqlite.exec("insert into settings (key, value, updated_at, updated_by) values (?, ?, ?, ?) on conflict(key) do update set value = excluded.value, updated_at = excluded.updated_at, updated_by = excluded.updated_by", key, stored, time.now(), user_id)
    invalidate_config()
    return true

fn bool clear_override(string key):
    await sqlite.exec("delete from settings where key = ?", key)
    invalidate_config()
    return true
