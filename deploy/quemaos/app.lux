# Drive — sonda de estado para QuemaOS.
#
#   PROBE_DB=/var/lib/drive/drive.db lux --no-watch ./quemaos
#
# Contrato (el mismo que el de Homeflix y Calendar; ver Suite-Canon.md):
#
#   GET /quemaos/status -> {"quemaos": 1, "id": "drive", "name": "Drive",
#                           "status": "ok"|"warn"|"error", "message": "...",
#                           "metrics": {...}, "extra": {...}}
#
# Drive es una app Python (FastAPI) y su sonda es esta app Lux APARTE, en su propio puerto
# (rango 9700-9799), por la misma razón que en el resto de la suite: que un Drive saturado
# de tráfico real no la deje en cola y dé un falso «caído». La petición no toca la base de
# datos ni el disco: contesta con lo último que midió el reloj de abajo (cada 30 s), y si el
# reloj se para la propia sonda lo delata.
#
# Variables (las prepara quemaos-run.sh a partir de /etc/drive/drive.env): PROBE_DB (la base
# de Drive; sólo se hacen SELECT), PROBE_URL (dónde escucha Drive, para comprobar /healthz),
# PROBE_STORAGE_ROOT (para mirar el disco), PROBE_PORT (9704) y PROBE_HOST
# (127.0.0.1: QuemaOS sólo consulta el bucle local).

import sqlite
import http
import os
import time
import json

app:
    name   "Drive (sonda QuemaOS)"
    port   env("PROBE_PORT", "9704")
    host   env("PROBE_HOST", "127.0.0.1")
    max_body "1KB"

    log:
        level "info"
        access false

    sqlite:
        file env("PROBE_DB")
        pool 1

fn string drive_url():
    return os.getenv("PROBE_URL", "http://127.0.0.1:8000")

fn string human(long n):
    if n < 1024:
        return str(n) + " B"
    if n < 1048576:
        return str(int(n / 1024)) + " KB"
    if n < 1073741824:
        return str(int(n / 1048576)) + " MB"
    return str(int(n / 1073741824)) + " GB"

fn Json count(string sql):
    List<Json> rows = await sqlite.query(sql)
    return rows[0]["n"]

# Mide y deja el resultado en `state`. Es lo único que toca la base, el disco y la red.
fn bool measure():
    Json metrics = {}
    Json extra = {}
    string status = "ok"
    string message = ""
    try:
        # Sólo SELECT: el driver de Lux no tiene modo de sólo lectura, así que esta garantía
        # es de este fichero, no de la base.
        metrics["usuarios"] = await count("select count(*) as n from users where is_active = 1")
        metrics["archivos"] = await count("select count(*) as n from nodes where is_dir = 0 and deleted_at is null")
        metrics["en_papelera"] = await count("select count(*) as n from nodes where deleted_at is not null")
        metrics["bytes_guardados"] = await count("select coalesce(sum(size), 0) as n from blobs")
        metrics["enlaces_activos"] = await count("select count(*) as n from share_links where revoked = 0")
    catch e:
        state.set("probe", { "status": "error", "message": "La base de datos no responde: " + e.message, "metrics": metrics, "extra": extra, "at": time.now() })
        return false

    # ¿Responde Drive? (healthz no toca nada pesado)
    bool up = false
    string why = ""
    try:
        Json r = await http.get(drive_url() + "/healthz", {}, { "timeout_ms": 2000 })
        up = r["status"] == 200
        why = "respondió " + str(r["status"])
    catch e:
        why = e.message
    metrics["servidor_activo"] = up ? 1 : 0

    # El directorio de ficheros se crea con la primera subida: sin nada guardado, que falte es normal.
    string root = os.getenv("PROBE_STORAGE_ROOT", "")
    string where = root
    if where == "" or not os.is_dir(where):
        string dbfile = os.getenv("PROBE_DB", "")
        where = dbfile == "" ? "" : os.path_dirname(dbfile)
    bool stored = metrics["bytes_guardados"] > 0
    if root != "" and not os.is_dir(root) and stored:
        status = "error"
        message = "No existe el directorio de ficheros: " + root
    else if where != "" and os.is_dir(where):
        Json du = os.disk_usage(where)
        long free_pct = du["total"] > 0 ? int(du["free"] * 1000 / du["total"]) : 0
        metrics["disco_libre_pct"] = free_pct / 10.0
        extra["disco_libre"] = human(du["free"]) + " de " + human(du["total"])
        if free_pct < 30:
            status = "error"
            message = "Disco casi lleno: " + str(free_pct / 10.0) + " % libre"
        else if free_pct < 100:
            status = "warn"
            message = "Poco espacio en disco: " + str(free_pct / 10.0) + " % libre"
    string dbf = os.getenv("PROBE_DB", "")
    if dbf != "" and os.is_file(dbf):
        extra["base_de_datos"] = human(os.file_size(dbf))
    if not up:
        status = "error"
        message = "Drive no responde (" + why + ")"
    if message == "":
        message = str(metrics["usuarios"]) + " usuarios · " + str(metrics["archivos"]) + " archivos · " + human(metrics["bytes_guardados"])
    state.set("probe", { "status": status, "message": message, "metrics": metrics, "extra": extra, "at": time.now() })
    return true

# El rango 9700-9799 lo impone el lanzador (quemaos-run.sh): una app Lux no puede salir desde
# `on start:`. Si aun así arranca fuera de rango, la sonda lo dice en su estado.
fn bool port_ok():
    int port = int(os.getenv("PROBE_PORT", "9704"))
    return port >= 9700 and port <= 9799

on start:
    state.set("probe", { "status": "warn", "message": "Arrancando: aún sin medidas", "metrics": {}, "extra": {}, "at": 0 })
    if port_ok():
        await measure()
    else:
        state.set("probe", { "status": "error", "message": "PROBE_PORT está fuera del rango 9700-9799 de la suite", "metrics": {}, "extra": {}, "at": 0 })

every "30s":
    try:
        if port_ok():
            await measure()
    catch e:
        log.error("sonda: fallo al medir: " + e.message)

get endpoint("/quemaos/status"):
    Json d = state.get("probe", { "status": "warn", "message": "sin medidas", "metrics": {}, "extra": {}, "at": 0 })
    string status = d["status"]
    string message = d["message"]
    if d["at"] > 0:
        long age = time.now() - d["at"]
        if age > 300000:
            status = "error"
            message = "Sin medidas desde hace " + str(int(age / 60000)) + " min: el reloj de medida se ha parado"
        else if age > 90000 and status == "ok":
            status = "warn"
            message = "Medidas desactualizadas (hace " + str(int(age / 1000)) + " s)"
    return {
        "quemaos": 1,
        "id": "drive",
        "name": "Drive",
        "status": status,
        "message": message,
        "metrics": d["metrics"],
        "extra": d["extra"]
    }
